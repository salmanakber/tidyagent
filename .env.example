# App
# Local: http://localhost:3000
# VPS: public URL only — never 0.0.0.0. Example: https://agent.tidyfloawapp.com
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Session — never expose to the browser
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Widget init tokens — never expose to the browser
WIDGET_TOKEN_SECRET="replace-with-a-different-long-random-secret"

# Database
DATABASE_URL="postgresql://tidyagent:tidyagent@localhost:5432/tidyagent?schema=public"

# Wix app credentials — never expose to the browser
WIX_APP_ID=""
WIX_APP_SECRET=""
WIX_APP_PUBLIC_KEY=""

# Map Wix Pricing plan IDs (vendorProductId / packageName) to tidyAgent plans
WIX_VENDOR_PRODUCT_STARTER=""
WIX_VENDOR_PRODUCT_GROWTH=""
WIX_VENDOR_PRODUCT_PRO=""

# Platform owner (tidyAgent operator) — manages every connected Wix site
PLATFORM_ADMIN_EMAIL="owner@tidyagent.local"
PLATFORM_ADMIN_PASSWORD="change-me-platform-admin"
PLATFORM_ADMIN_EMAILS="owner@tidyagent.local"

# Local development without a live Wix install
# Creates a signed demo session so the dashboard is fully usable
TIDYAGENT_DEV_MODE="true"

# AI keys can also be set in Platform admin → Settings (encrypted in the database).
# Failover order default: gemini → groq → openai
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="gemini,groq,openai"

# Google login (or set in Platform admin → Settings)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary — agent & widget profile photos (or set in Platform admin → Settings)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Redis / BullMQ (Phase 2 background jobs)
REDIS_URL="redis://localhost:6379"
