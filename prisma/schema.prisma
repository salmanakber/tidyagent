generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PlanKey {
  FREE
  STARTER
  GROWTH
  PRO
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum OnboardingStatus {
  INSTALLED
  SITE_CONNECTED
  ANALYZING
  QUESTIONS
  CONFIGURED
  TESTED
  PUBLISHED
}

enum SitePlatform {
  WIX
  WEBFLOW
  SHOPIFY
}

enum BillingProvider {
  WIX
  STRIPE
}

enum WidgetPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum WidgetEmbedMode {
  AUTO
  MANUAL
}

enum WidgetTemplate {
  CLASSIC
  SOFT
  BAR
  MINIMAL
}

enum AgentSpecialty {
  GENERAL
  ECOMMERCE
  SUPPORT
  BOOKINGS
  CONTENT
}

enum KnowledgeContentType {
  PAGE
  PRODUCT
  FAQ
  POLICY
  CUSTOM
  SERVICE
}

enum KnowledgeFactKind {
  BUSINESS
  SERVICE
  PRODUCT
  PACKAGE
  PRICE
  CONTACT
  HOURS
  LOCATION
  POLICY
  FAQ
  BOOKING
}

enum KnowledgeConfidence {
  HIGH
  MEDIUM
  LOW
}

enum KnowledgeConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum ConversationStatus {
  OPEN
  RESOLVED
  ESCALATED
}

enum MessageRole {
  CUSTOMER
  AGENT
  HUMAN
  SYSTEM
}

enum ToolPermissionMode {
  DISABLED
  ALLOWED
  CONFIRM
}

model User {
  id            String   @id @default(cuid())
  wixUserId     String?  @unique
  googleId      String?
  email         String?
  name          String?
  passwordHash  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   OrganizationMember[]

  @@index([email])
  @@index([googleId])
}

model Organization {
  id                String            @id @default(cuid())
  name              String
  onboardingStatus  OnboardingStatus  @default(INSTALLED)
  accessStatus      String            @default("active")
  suspendedAt       DateTime?
  suspendedReason   String?
  /// Complimentary paid seat from platform admin. Survives Wix billing sync.
  compPlanKey       PlanKey?
  compGrantedAt     DateTime?
  compGrantedBy     String?
  compNote          String?
  /// Real person visitors are connected to on human handoff (not an AI specialist).
  humanAgentName      String?
  humanAgentRole      String?  @default("Team")
  humanAgentAvatarUrl String?
  humanAgentEmail     String?
  /// Business WhatsApp in E.164 (e.g. +923001234567). Used for visitor handoff.
  humanAgentWhatsapp  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  members           OrganizationMember[]
  sites             WixSite[]
  subscriptions     Subscription[]
  usageRecords      UsageRecord[]
  businessProfile   BusinessProfile?
  knowledgeSources  KnowledgeSource[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks   KnowledgeChunk[]
  knowledgeFacts    KnowledgeFact[]
  knowledgeConflicts KnowledgeConflict[]
  agents            Agent[]
  customers         Customer[]
  conversations     Conversation[]
  messages          Message[]
  conversationEvents ConversationEvent[]
  tools             Tool[]
  toolExecutions    ToolExecution[]
  humanEscalations  HumanEscalation[]
  products          Product[]
  orders            Order[]
  appointments      Appointment[]
  analyticsEvents   AnalyticsEvent[]
  auditLogs         AuditLog[]
  improvementSuggestions ImprovementSuggestion[]
  billingEvents     BillingEvent[]
}

model OrganizationMember {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model WixSite {
  id                 String   @id @default(cuid())
  organizationId     String
  /// Physical table stays WixSite so production Wix rows are untouched.
  platform           SitePlatform @default(WIX)
  wixInstanceId      String   @unique
  wixSiteId          String?
  webflowSiteId      String?  @unique
  shopifyShopDomain  String?  @unique
  displayName        String?
  url                String?
  locale             String?
  currency           String?
  ownerEmail         String?
  originInstanceId   String?
  installedWixApps   Json     @default("[]")
  capabilities       Json     @default("{}")
  connectionStatus   String   @default("connected")
  accessStatus       String   @default("active")
  suspendedAt        DateTime?
  suspendedReason    String?
  lastSyncedAt       DateTime?
  lastBillingSyncedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential         WixCredential?
  agents             Agent[]
  conversations      Conversation[]

  @@index([organizationId])
  @@index([wixSiteId])
  @@index([platform])
}

model WixCredential {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String   @unique
  instanceId     String
  /// Encrypted at rest in later phases. Never sent to the browser.
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site           WixSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([instanceId])
}

model Plan {
  id                      String   @id @default(cuid())
  key                     PlanKey  @unique
  name                    String
  wixVendorProductId      String?
  conversationLimit       Int
  knowledgeLimit          Int
  voiceEnabled            Boolean  @default(false)
  advancedToolsEnabled    Boolean  @default(false)
  automationEnabled       Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  subscriptions           Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  wixSubscriptionId  String?
  planId             String
  planKey            PlanKey            @default(FREE)
  status             SubscriptionStatus @default(NONE)
  isFree             Boolean            @default(true)
  vendorProductId    String?
  billingCycle       String?
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  autoRenewing       Boolean            @default(false)
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  cancelReason       String?
  invoiceId          String?
  couponName         String?
  previousVendorProductId String?
  billingIssue       Boolean            @default(false)
  billingProvider    BillingProvider    @default(WIX)
  /// Stripe customer id for Webflow/Shopify seats. Unused for Wix.
  stripeCustomerId   String?
  /// Stripe subscription id for Webflow/Shopify seats. Unused for Wix.
  stripeSubscriptionId String?
  rawBilling         Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@index([wixSubscriptionId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  metric         String
  quantity       Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, periodStart])
}

model BusinessProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  siteId         String?
  name           String?
  businessType   String?
  industry       String?
  businessModel  String?
  summary        String?
  structured     Json     @default("{}")
  capabilities   Json     @default("{}")
  analyzedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model KnowledgeSource {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  type           String
  url            String?
  title          String?
  status         String   @default("pending")
  lastSyncedAt   DateTime?
  pagesDiscovered Int     @default(0)
  pagesCrawled   Int      @default(0)
  pagesFailed    Int      @default(0)
  crawlVersion   Int      @default(0)
  lastError      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      KnowledgeDocument[]

  @@index([organizationId])
  @@index([organizationId, siteId])
}

model KnowledgeDocument {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  sourceId       String?
  title          String
  contentType    KnowledgeContentType @default(PAGE)
  sourceUrl      String?
  rawContent     String?
  cleanedContent String?
  contentHash    String?
  extractionMethod String @default("http")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  chunks         KnowledgeChunk[]
  facts          KnowledgeFact[]

  @@index([organizationId])
  @@index([organizationId, siteId])
  @@index([contentType])
  @@index([sourceUrl])
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  documentId     String
  content        String
  sourceUrl      String?
  title          String?
  contentType    KnowledgeContentType @default(PAGE)
  metadata       Json     @default("{}")
  /// pgvector embedding — always filtered by organizationId before ranking
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([siteId])
  @@index([documentId])
}

model KnowledgeFact {
  id               String              @id @default(cuid())
  organizationId   String
  siteId           String
  documentId       String?
  kind             KnowledgeFactKind
  entity           String
  entityKey        String
  value            String
  sourceUrl        String?
  extractionMethod String              @default("html")
  confidence       KnowledgeConfidence @default(MEDIUM)
  crawlVersion     Int                 @default(1)
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         KnowledgeDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, siteId, kind])
  @@index([organizationId, entityKey])
}

model KnowledgeConflict {
  id             String                   @id @default(cuid())
  organizationId String
  siteId         String
  kind           KnowledgeFactKind
  entity         String
  entityKey      String
  values         Json
  status         KnowledgeConflictStatus  @default(OPEN)
  resolvedValue  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, siteId, kind, entityKey])
  @@index([organizationId, status])
}

model Agent {
  id                  String         @id @default(cuid())
  organizationId      String
  siteId              String
  name                String         @default("Sarah")
  role                String         @default("Customer Assistant")
  personality         String         @default("friendly")
  tone                String?
  status              AgentStatus    @default(DRAFT)
  focus               String[]       @default([])
  goals               Json           @default("[]")
  publishedAt         DateTime?
  widgetPrimaryColor  String         @default("#1F3A5F")
  widgetUseGradient   Boolean        @default(false)
  widgetGradientTo    String         @default("#4F8CFF")
  widgetGradientAngle String         @default("to-bottom-right")
  widgetTextColor     String         @default("#FFFFFF")
  widgetMessageColor  String         @default("#1E293B")
  widgetAvatarUrl     String?
  widgetPosition      WidgetPosition @default(BOTTOM_RIGHT)
  widgetGreeting      String         @default("Hi! How can I help you today?")
  widgetEmbedMode     WidgetEmbedMode @default(AUTO)
  widgetTemplate      WidgetTemplate @default(CLASSIC)
  voiceEnabled        Boolean        @default(true)
  voiceId             String         @default("en-US-Neural2-F")
  isPrimary           Boolean        @default(false)
  specialty           AgentSpecialty @default(GENERAL)
  knowledgeScopes     String[]       @default(["PAGE", "FAQ", "POLICY", "CUSTOM"])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                WixSite        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  capabilities        AgentCapability[]
  rules               AgentRule[]
  toolPermissions     AgentToolPermission[]
  workflows           AgentWorkflow[]
  conversations       Conversation[]

  @@index([organizationId])
  @@index([siteId])
}

model AgentCapability {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  key            String
  enabled        Boolean  @default(true)
  source         String   @default("recommended")
  createdAt      DateTime @default(now())

  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([organizationId])
}

model AgentRule {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  key            String
  description    String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([organizationId])
}

model AgentToolPermission {
  id             String             @id @default(cuid())
  organizationId String
  agentId        String
  toolKey        String
  mode           ToolPermissionMode @default(DISABLED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  agent          Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolKey])
  @@index([organizationId])
}

model AgentWorkflow {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  key            String
  enabled        Boolean  @default(true)
  config         Json     @default("{}")
  createdAt      DateTime @default(now())

  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  wixContactId   String?
  email          String?
  name           String?
  phone          String?
  memory         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  @@index([organizationId])
  @@index([wixContactId])
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  siteId         String
  agentId        String?
  customerId     String?
  visitorId      String?
  status         ConversationStatus @default(OPEN)
  language       String?
  metadata       Json               @default("{}")
  startedAt      DateTime           @default(now())
  lastMessageAt  DateTime           @default(now())
  resolvedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           WixSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages       Message[]
  events         ConversationEvent[]
  toolExecutions ToolExecution[]
  escalations    HumanEscalation[]

  @@index([organizationId, lastMessageAt])
  @@index([visitorId])
}

model Message {
  id             String      @id @default(cuid())
  organizationId String
  conversationId String
  role           MessageRole
  content        String
  evidence       Json?
  confidence     Float?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([conversationId, createdAt])
}

model ConversationEvent {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String
  type           String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Tool {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  name           String
  description    String
  requiresConfirm Boolean @default(false)
  createdAt      DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions     ToolExecution[]

  @@unique([organizationId, key])
}

model ToolExecution {
  id                  String   @id @default(cuid())
  organizationId      String
  siteId              String?
  agentId             String?
  customerId          String?
  conversationId      String?
  toolId              String?
  toolKey             String
  action              String
  input               Json
  result              Json?
  permissionDecision  String
  success             Boolean  @default(false)
  createdAt           DateTime @default(now())

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  tool                Tool? @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model HumanEscalation {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String
  reason         String
  summary        String?
  status         String   @default("open")
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  wixProductId   String
  name           String
  data           Json
  syncedAt       DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, wixProductId])
  @@index([organizationId])
}

model Order {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  wixOrderId     String
  number         String?
  data           Json
  syncedAt       DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, wixOrderId])
  @@index([organizationId])
}

model Appointment {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  wixBookingId   String
  data           Json
  syncedAt       DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, wixBookingId])
  @@index([organizationId])
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  type           String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
}

model AuditLog {
  id                 String   @id @default(cuid())
  organizationId     String
  siteId             String?
  agentId            String?
  customerId         String?
  conversationId     String?
  tool               String?
  action             String
  input              Json?
  result             Json?
  permissionDecision String?
  createdAt          DateTime @default(now())

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model ImprovementSuggestion {
  id             String   @id @default(cuid())
  organizationId String
  topic          String
  question       String
  occurrences    Int      @default(1)
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model BillingEvent {
  id              String   @id @default(cuid())
  organizationId  String?
  siteId          String?
  wixInstanceId   String
  eventType       String
  vendorProductId String?
  payload         Json     @default("{}")
  createdAt       DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([wixInstanceId, createdAt])
  @@index([organizationId])
}

model PlatformAdmin {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        String    @default("SUPER")
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  auditLogs   PlatformAuditLog[]
}

model PlatformAuditLog {
  id             String   @id @default(cuid())
  adminId        String?
  adminEmail     String
  action         String
  organizationId String?
  siteId         String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  admin          PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([organizationId])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}


